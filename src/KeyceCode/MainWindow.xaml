<Window x:Class="KeyceCode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KeyceCode" Height="900" Width="1480" MinHeight="620" MinWidth="980"
        Icon="/KeyceCode;component/Assets/KeyceCode.png" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource ForegroundBrush}"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="27"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
    <!-- Title bar / command center -->
    <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,8,0"><Image Source="/KeyceCode;component/Assets/KeyceCode.png" Width="18" Height="18"/><TextBlock Text="KeyceCode" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="NavigateBackButton" Content="‹" FontSize="17" Padding="7,1" Click="NavigateBack_Click" ToolTip="Revenir dans l’historique" IsEnabled="False"/><Button x:Name="NavigateForwardButton" Content="›" FontSize="17" Padding="7,1" Click="NavigateForward_Click" ToolTip="Avancer dans l’historique" IsEnabled="False"/></StackPanel>
      <Border Grid.Column="2" Width="430" Height="25" Background="{DynamicResource TabBarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="CommandCenter_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"><TextBlock x:Name="CommandCenterText" Text="Rechercher des commandes, fichiers et symboles" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="✦ KeyceIA" Foreground="#FFFFAC55" Click="ToggleAssistant_Click"/><Button Content="─" Padding="10,3" Click="MinimizeWindow_Click"/><Button Content="□" Padding="10,3" Click="MaximizeWindow_Click"/><Button Content="×" Padding="10,3" FontSize="14" Click="CloseWindow_Click"/></StackPanel>
    </Grid>
    <DockPanel Grid.Row="1" Background="{DynamicResource SidebarBackground}" LastChildFill="True">
      <Menu DockPanel.Dock="Left" Background="Transparent" Foreground="{DynamicResource ForegroundBrush}">
        <MenuItem Header="Fichier"><MenuItem Header="Nouveau fichier" InputGestureText="Ctrl+N" Click="NewFile_Click"/><MenuItem Header="Ouvrir un fichier…" InputGestureText="Ctrl+O" Click="OpenFile_Click"/><MenuItem Header="Ouvrir un dossier…" InputGestureText="Ctrl+K Ctrl+O" Click="OpenFolder_Click"/><Separator/><MenuItem Header="Enregistrer" InputGestureText="Ctrl+S" Click="Save_Click"/><MenuItem Header="Enregistrer sous…" Click="SaveAs_Click"/><Separator/><MenuItem Header="Fermer l’éditeur" InputGestureText="Ctrl+W" Click="CloseEditor_Click"/><MenuItem Header="Quitter" Click="CloseWindow_Click"/></MenuItem>
        <MenuItem Header="Édition"><MenuItem Header="Annuler" InputGestureText="Ctrl+Z" Click="Undo_Click"/><MenuItem Header="Rétablir" InputGestureText="Ctrl+Y" Click="Redo_Click"/><Separator/><MenuItem Header="Rechercher dans les fichiers" InputGestureText="Ctrl+Shift+F" Click="ShowSearch_Click"/><MenuItem Header="Remplacer dans les fichiers" InputGestureText="Ctrl+Shift+H" Click="ShowSearch_Click"/></MenuItem>
        <MenuItem Header="Sélection"><MenuItem Header="Tout sélectionner" InputGestureText="Ctrl+A" Click="SelectAll_Click"/><MenuItem Header="Ajouter le curseur à la ligne suivante" InputGestureText="Ctrl+Alt+Down" Click="AddCursorDown_Click"/></MenuItem>
        <MenuItem Header="Affichage"><MenuItem Header="Afficher/masquer la barre latérale" InputGestureText="Ctrl+B" Click="ToggleSidebar_Click"/><MenuItem Header="Afficher/masquer le panneau" InputGestureText="Ctrl+J" Click="TogglePanel_Click"/><MenuItem Header="Afficher l’explorateur" InputGestureText="Ctrl+Shift+E" Click="ShowExplorer_Click"/><MenuItem Header="Afficher les extensions" InputGestureText="Ctrl+Shift+X" Click="ShowExtensions_Click"/><MenuItem Header="KeyceIA" Click="ToggleAssistant_Click"/><Separator/><MenuItem Header="Thème de couleurs" Click="Theme_Click"/></MenuItem>
        <MenuItem Header="Aller à"><MenuItem Header="Accéder au fichier…" InputGestureText="Ctrl+P" Click="QuickOpen_Click"/><MenuItem Header="Accéder à la ligne…" InputGestureText="Ctrl+G" Click="GoToLine_Click"/><MenuItem Header="Palette de commandes…" InputGestureText="Ctrl+Shift+P" Click="CommandPalette_Click"/></MenuItem>
        <MenuItem Header="Exécuter"><MenuItem Header="Exécuter sans déboguer" InputGestureText="Ctrl+F5" Click="Run_Click"/><MenuItem Header="Démarrer le débogage" InputGestureText="F5" IsEnabled="False"/><MenuItem Header="Arrêter" InputGestureText="Shift+F5" Click="StopRun_Click"/></MenuItem>
        <MenuItem Header="Terminal"><MenuItem Header="Nouveau terminal" InputGestureText="Ctrl+Shift+ù" Click="NewTerminal_Click"/><MenuItem Header="Effacer" Click="ClearPanel_Click"/></MenuItem>
        <MenuItem Header="Aide"><MenuItem Header="À propos de KeyceCode" Click="About_Click"/><MenuItem Header="Ouvrir les paramètres" InputGestureText="Ctrl+," Click="Settings_Click"/></MenuItem>
      </Menu>
      <TextBlock x:Name="WorkspaceTitle" Text="Aucun dossier ouvert" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DockPanel>
    <!-- Workbench -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="ActivityColumn" Width="48"/><ColumnDefinition x:Name="SidebarColumn" Width="250"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SecondarySidebarColumn" Width="0"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition x:Name="PanelRow" Height="230"/></Grid.RowDefinitions>
      <!-- Activity bar -->
      <Border Grid.Column="0" Grid.RowSpan="3" Background="{DynamicResource ActivityBarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel><StackPanel DockPanel.Dock="Top">
          <Button x:Name="ActivityExplorer" Content="◫" FontSize="23" Height="48" Click="ShowExplorer_Click" ToolTip="Explorateur — Ctrl+Shift+E" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0"/>
          <Button x:Name="ActivitySearch" Content="⌕" FontSize="24" Height="48" Click="ShowSearch_Click" ToolTip="Recherche — Ctrl+Shift+F"/>
          <Button x:Name="ActivitySourceControl" Content="⑂" FontSize="23" Height="48" Click="ShowSourceControl_Click" ToolTip="Contrôle de code source"/>
          <Button x:Name="ActivityRun" Content="▷" FontSize="23" Height="48" Click="ShowRun_Click" ToolTip="Exécuter et déboguer"/>
          <Button x:Name="ActivityExtensions" Content="▧" FontSize="21" Height="48" Click="ShowExtensions_Click" ToolTip="Extensions"/>
        </StackPanel><StackPanel DockPanel.Dock="Bottom"><Button Content="⚙" FontSize="22" Height="48" Click="Settings_Click" ToolTip="Gérer les paramètres"/><Button Content="✦" Foreground="#FFFFA34A" FontSize="21" Height="48" Click="ToggleAssistant_Click" ToolTip="KeyceIA"/></StackPanel></DockPanel>
      </Border>
      <!-- Primary view container -->
      <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource SidebarBackground}">
        <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="14,0,8,0"><TextBlock x:Name="SidebarHeading" Text="EXPLORATEUR" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="…" Padding="4,2" ToolTip="Autres actions"/></StackPanel></DockPanel>
        <Grid Grid.Row="1">
          <Grid x:Name="ExplorerView"><DockPanel>
            <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="WorkspaceFolderLabel" Text="OUVRIR UN DOSSIER POUR COMMENCER" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="15,8,8,8"/><DockPanel Margin="8,0,8,7"><Button Content="📁" Click="OpenFolder_Click" ToolTip="Ouvrir un dossier"/><Button Content="＋ Fichier" Click="ExplorerNewFile_Click" HorizontalAlignment="Stretch"/><Button Content="＋ Dossier" Click="ExplorerNewFolder_Click" HorizontalAlignment="Stretch"/><Button Content="⟳" Click="ExplorerRefresh_Click" ToolTip="Actualiser l’Explorateur"/></DockPanel></StackPanel>
            <TreeView x:Name="ExplorerTree" SelectedItemChanged="ExplorerTree_SelectedItemChanged" MouseDoubleClick="ExplorerTree_DoubleClick"/>
          </DockPanel></Grid>
          <Grid x:Name="SearchView" Visibility="Collapsed" Margin="12"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="RECHERCHE" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox x:Name="SearchQuery" Height="28" Margin="0,0,0,6" KeyDown="SearchQuery_KeyDown"/><DockPanel><TextBlock Text="Aa   ab   .*" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><TextBox x:Name="SearchFilesPattern" Width="110" Height="24" ToolTip="Inclure les fichiers"/></DockPanel><Button Content="Rechercher dans les fichiers" Click="SearchWorkspace_Click" HorizontalAlignment="Stretch" Margin="0,7,0,8"/></StackPanel><ListBox x:Name="SearchResults" MouseDoubleClick="SearchResults_DoubleClick" Background="Transparent" BorderThickness="0"/></DockPanel></Grid>
          <Grid x:Name="SourceControlView" Visibility="Collapsed" Margin="12"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="CONTRÔLE DE CODE SOURCE" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox x:Name="CommitMessage" Height="48" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Message de validation"/><Button Content="✓ Valider" Click="Commit_Click" HorizontalAlignment="Stretch" Background="{DynamicResource AccentBrush}" Margin="0,7,0,10"/><TextBlock x:Name="GitBranchLabel" Text="Aucun dépôt Git détecté" Foreground="{DynamicResource MutedBrush}"/></StackPanel><ListBox x:Name="GitChanges" Background="Transparent" BorderThickness="0"/></DockPanel></Grid>
          <Grid x:Name="RunView" Visibility="Collapsed" Margin="12"><DockPanel><StackPanel><TextBlock Text="EXÉCUTER ET DÉBOGUER" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12"/><Button Content="▷ Exécuter le fichier" Click="Run_Click" HorizontalContentAlignment="Left"/><Button Content="▶ Débogueur (adaptateur requis)" IsEnabled="False" HorizontalContentAlignment="Left"/><Button Content="⏹ Arrêter" Click="StopRun_Click" HorizontalContentAlignment="Left"/><TextBlock Text="L’exécution des projets et scripts compatibles est disponible. Aucun adaptateur de débogage n’est configuré." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="8,16,8,0"/></StackPanel></DockPanel></Grid>
          <Grid x:Name="ExtensionsView" Visibility="Collapsed" Margin="12"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="EXTENSIONS" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox x:Name="ExtensionSearch" Height="28"/><Button Content="Rechercher sur le Marketplace" Click="SearchMarketplace_Click" HorizontalAlignment="Stretch" Margin="0,7,0,0"/></StackPanel><TextBlock Text="Catalogue d’extensions non configuré. L’application n’installe rien tant qu’une source de galerie fiable n’est pas déclarée." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4,18,4,0"/></DockPanel></Grid>
        </Grid>
      </Grid>
      <GridSplitter x:Name="WorkbenchGridSplitter" Grid.Column="2" Grid.Row="0" Grid.RowSpan="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>
      <!-- Editor region -->
      <Grid Grid.Column="3" Grid.Row="0">
        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <DockPanel><StackPanel x:Name="EditorTabs" Orientation="Horizontal"/><Button Content="+" DockPanel.Dock="Right" Click="NewFile_Click" ToolTip="Nouvel éditeur"/><Button Content="▦" DockPanel.Dock="Right" IsEnabled="False" ToolTip="Groupes d’éditeurs côte à côte non disponibles"/></DockPanel>
        </Border>
        <DockPanel Grid.Row="1" Background="{DynamicResource EditorBackground}"><TextBlock x:Name="Breadcrumbs" Text="Aucun fichier ouvert" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="14,0"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="⟲" Click="FormatDocument_Click" ToolTip="Formater le document"/></StackPanel></DockPanel>
        <Grid Grid.Row="2" Background="{DynamicResource EditorBackground}"><wv:WebView2 x:Name="CodeEditor" DefaultBackgroundColor="#FF1E1E1E"/></Grid>
      </Grid>
      <!-- Secondary sidebar / KeyceIA -->
      <Border Grid.Column="4" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" x:Name="SecondarySidebar">
        <DockPanel Margin="10"><StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock Text="KEYCEIA" FontWeight="SemiBold" Foreground="#FFFFA34A" Margin="4,8,0,12"/><Button Content="×" DockPanel.Dock="Right" Click="ToggleAssistant_Click"/></DockPanel><TextBlock Text="Assistant Gemini · le contexte n’est envoyé qu’à votre demande." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4,0,4,10"/></StackPanel>
          <StackPanel DockPanel.Dock="Bottom"><TextBox x:Name="PromptBox" Height="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><Button Content="Envoyer" Click="Ask_Click" Background="{DynamicResource AccentBrush}" HorizontalContentAlignment="Center" Margin="0,8,0,0"/><Button Content="Compléter au curseur · Ctrl+Espace" Click="Complete_Click" HorizontalContentAlignment="Center" Margin="0,4,0,0"/></StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="AssistantOutput" Text="Posez une question sur le code sélectionné ou ajoutez un contexte." TextWrapping="Wrap" Foreground="{DynamicResource EditorForeground}" Margin="4,8"/></ScrollViewer>
        </DockPanel>
      </Border>
      <!-- Bottom panel -->
      <GridSplitter x:Name="PanelSplitter" Grid.Column="3" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Grid Grid.Column="3" Grid.Row="2" Background="{DynamicResource PanelBackground}">
        <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><DockPanel><StackPanel Orientation="Horizontal"><Button Content="PROBLÈMES" Click="ShowProblems_Click"/><Button Content="SORTIE" Click="ShowOutput_Click"/><Button Content="CONSOLE DE DÉBOGAGE" Click="ShowDebugConsole_Click"/><Button Content="TERMINAL" Click="ShowTerminal_Click" Background="{DynamicResource PanelBackground}"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="+" Click="NewTerminal_Click" ToolTip="Nouveau terminal"/><Button Content="⌄" Click="SelectTerminalProfile_Click" ToolTip="Sélectionner le profil du terminal"/><Button Content="×" Click="TogglePanel_Click" ToolTip="Masquer le panneau"/></StackPanel></DockPanel></Border>
        <Grid Grid.Row="1">
          <Grid x:Name="TerminalPanel"><DockPanel><ListBox x:Name="TerminalSessions" DockPanel.Dock="Top" Height="24" Background="{DynamicResource PanelBackground}" BorderThickness="0" HorizontalContentAlignment="Left"/><TextBox x:Name="TerminalInput" DockPanel.Dock="Bottom" Height="27" KeyDown="TerminalInput_KeyDown" BorderThickness="0,1,0,0" Background="{DynamicResource PanelBackground}" FontFamily="Cascadia Code, Consolas"/><TextBox x:Name="TerminalOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource ForegroundBrush}" BorderThickness="0" Padding="12,6" FontFamily="Cascadia Code, Consolas"/></DockPanel></Grid>
          <ListView x:Name="ProblemsPanel" Visibility="Collapsed" Background="{DynamicResource PanelBackground}" BorderThickness="0"><ListView.View><GridView><GridViewColumn Header="Sévérité" DisplayMemberBinding="{Binding Severity}" Width="100"/><GridViewColumn Header="Message" DisplayMemberBinding="{Binding Message}" Width="600"/><GridViewColumn Header="Fichier" DisplayMemberBinding="{Binding File}" Width="250"/><GridViewColumn Header="Ligne" DisplayMemberBinding="{Binding Line}" Width="65"/></GridView></ListView.View></ListView>
          <TextBox x:Name="OutputPanel" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource ForegroundBrush}" BorderThickness="0" Padding="12"/>
          <TextBox x:Name="DebugConsolePanel" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource ForegroundBrush}" BorderThickness="0" Padding="12"/>
        </Grid>
      </Grid>
    </Grid>
    <!-- Status bar -->
    <DockPanel Grid.Row="3" Background="{DynamicResource StatusBarBackground}" LastChildFill="True"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button x:Name="StatusGitBranch" Content="⑂ main" Padding="8,2" Click="ShowSourceControl_Click"/><Button x:Name="StatusErrors" Content="× 0" Padding="6,2" Click="ShowProblems_Click"/><Button x:Name="StatusWarnings" Content="⚠ 0" Padding="6,2" Click="ShowProblems_Click"/><TextBlock x:Name="StatusMessage" Text="Prêt" VerticalAlignment="Center" Margin="10,0"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="StatusCursor" Content="Ln 1, Col 1" Padding="8,2"/><Button x:Name="StatusIndentation" Content="Espaces: 4" Padding="8,2" Click="Settings_Click" ToolTip="Ouvrir les paramètres de l’éditeur"/><Button x:Name="StatusEncoding" Content="UTF-8" Padding="8,2" Click="Encoding_Click" ToolTip="Changer l’encodage du fichier"/><Button x:Name="StatusEol" Content="CRLF" Padding="8,2" Click="Eol_Click" ToolTip="Changer la fin de ligne"/><Button x:Name="StatusLanguage" Content="Texte brut" Padding="8,2" Click="Language_Click"/><Button Content="◖" Padding="8,2" IsEnabled="False" ToolTip="Notifications non configurées"/></StackPanel></DockPanel>
  </Grid>
</Window>


