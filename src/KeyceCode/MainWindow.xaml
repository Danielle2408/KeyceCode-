<Window x:Class="KeyceCode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KeyceCode" Height="900" Width="1480" MinHeight="620" MinWidth="980"
        Icon="/KeyceCode;component/Assets/KeyceCode.ico" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource ForegroundBrush}"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="27"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
    <!-- Title bar / command center -->
    <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,8,0"><Image Source="/KeyceCode;component/Assets/KeyceCode.png" Width="18" Height="18"/><TextBlock Text="KeyceCode" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="NavigateBackButton" Content="‹" FontSize="17" Padding="7,1" Click="NavigateBack_Click" ToolTip="Revenir dans l’historique" IsEnabled="False"/><Button x:Name="NavigateForwardButton" Content="›" FontSize="17" Padding="7,1" Click="NavigateForward_Click" ToolTip="Avancer dans l’historique" IsEnabled="False"/></StackPanel>
      <Border Grid.Column="2" Width="430" Height="25" Background="{DynamicResource TabBarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="CommandCenter_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"><TextBlock x:Name="CommandCenterText" Text="Rechercher des commandes, fichiers et symboles" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="✦ KeyceIA" Foreground="#FFFFAC55" Click="ToggleAssistant_Click"/><Button Content="─" Padding="10,3" Click="MinimizeWindow_Click"/><Button Content="□" Padding="10,3" Click="MaximizeWindow_Click"/><Button Content="×" Padding="10,3" FontSize="14" Click="CloseWindow_Click"/></StackPanel>
    </Grid>
    <DockPanel Grid.Row="1" Background="{DynamicResource SidebarBackground}" LastChildFill="True">
      <Menu DockPanel.Dock="Left" Background="Transparent" Foreground="{DynamicResource ForegroundBrush}">
        <MenuItem Header="Fichier"><MenuItem Header="Nouveau fichier" InputGestureText="Ctrl+N" Click="NewFile_Click"/><MenuItem Header="Ouvrir un fichier…" InputGestureText="Ctrl+O" Click="OpenFile_Click"/><MenuItem Header="Ouvrir un dossier…" InputGestureText="Ctrl+K Ctrl+O" Click="OpenFolder_Click"/><MenuItem x:Name="RecentWorkspacesMenu" Header="Ouvrir un dossier récent"><MenuItem Header="Aucun dossier récent" IsEnabled="False"/></MenuItem><MenuItem Header="Importer configuration VS Code…" Click="ImportVsCodeConfiguration_Click"/><MenuItem Header="Importer les raccourcis VS Code…" Click="ImportVsCodeKeybindings_Click"/><Separator/><MenuItem Header="Enregistrer" InputGestureText="Ctrl+S" Click="Save_Click"/><MenuItem Header="Enregistrer sous…" Click="SaveAs_Click"/><Separator/><MenuItem Header="Fermer l’éditeur" InputGestureText="Ctrl+W" Click="CloseEditor_Click"/><MenuItem Header="Quitter" Click="CloseWindow_Click"/></MenuItem>
        <MenuItem Header="Édition"><MenuItem Header="Annuler" InputGestureText="Ctrl+Z" Click="Undo_Click"/><MenuItem Header="Rétablir" InputGestureText="Ctrl+Y" Click="Redo_Click"/><Separator/><MenuItem x:Name="FormatOnSaveMenuItem" Header="Formater avant l’enregistrement" IsCheckable="True" Click="FormatOnSaveMenuItem_Click"/><Separator/><MenuItem Header="Rechercher dans les fichiers" InputGestureText="Ctrl+Shift+F" Click="ShowSearch_Click"/><MenuItem Header="Remplacer dans les fichiers" InputGestureText="Ctrl+Shift+H" Click="ShowSearch_Click"/></MenuItem>
        <MenuItem Header="Sélection"><MenuItem Header="Tout sélectionner" InputGestureText="Ctrl+A" Click="SelectAll_Click"/><MenuItem Header="Ajouter le curseur à la ligne suivante" InputGestureText="Ctrl+Alt+Down" Click="AddCursorDown_Click"/></MenuItem>
        <MenuItem Header="Affichage"><MenuItem Header="Afficher/masquer la barre latérale" InputGestureText="Ctrl+B" Click="ToggleSidebar_Click"/><MenuItem Header="Afficher/masquer le panneau" InputGestureText="Ctrl+J" Click="TogglePanel_Click"/><MenuItem Header="Afficher l’explorateur" InputGestureText="Ctrl+Shift+E" Click="ShowExplorer_Click"/><MenuItem Header="Afficher les extensions" InputGestureText="Ctrl+Shift+X" Click="ShowExtensions_Click"/><MenuItem Header="KeyceIA" Click="ToggleAssistant_Click"/><Separator/><MenuItem Header="Position du panneau"><MenuItem x:Name="PanelPositionBottomMenuItem" Header="En bas" Tag="Bottom" IsCheckable="True" Click="PanelPosition_Click"/><MenuItem x:Name="PanelPositionLeftMenuItem" Header="À gauche" Tag="Left" IsCheckable="True" Click="PanelPosition_Click"/><MenuItem x:Name="PanelPositionRightMenuItem" Header="À droite" Tag="Right" IsCheckable="True" Click="PanelPosition_Click"/></MenuItem><Separator/><MenuItem Header="Réinitialiser la disposition" Click="ResetWorkbenchLayout_Click"/><Separator/><MenuItem Header="Thème de couleurs" Click="Theme_Click"/></MenuItem>
        <MenuItem Header="Aller à"><MenuItem Header="Accéder au fichier…" InputGestureText="Ctrl+P" Click="QuickOpen_Click"/><MenuItem Header="Accéder à la ligne…" InputGestureText="Ctrl+G" Click="GoToLine_Click"/><MenuItem Header="Symbole dans l’espace de travail…" InputGestureText="Ctrl+T" Click="WorkspaceSymbols_Click"/><MenuItem Header="Palette de commandes…" InputGestureText="Ctrl+Shift+P" Click="CommandPalette_Click"/></MenuItem>
        <MenuItem Header="Exécuter"><MenuItem Header="Compiler le projet actif" InputGestureText="Ctrl+Shift+B" Click="Build_Click"/><MenuItem Header="Exécuter sans déboguer" InputGestureText="Ctrl+F5" Click="Run_Click"/><MenuItem Header="Démarrer / continuer le débogage" InputGestureText="F5" Click="Debug_Click"/><MenuItem Header="Arrêter" InputGestureText="Shift+F5" Click="StopRun_Click"/></MenuItem>
        <MenuItem Header="Terminal"><MenuItem Header="Nouveau terminal" InputGestureText="Ctrl+Shift+ù" Click="NewTerminal_Click"/><MenuItem Header="Effacer" Click="ClearPanel_Click"/></MenuItem>
        <MenuItem Header="Aide"><MenuItem Header="À propos de KeyceCode" Click="About_Click"/><MenuItem Header="Ouvrir les paramètres" InputGestureText="Ctrl+," Click="Settings_Click"/></MenuItem>
      </Menu>
      <TextBlock x:Name="WorkspaceTitle" Text="Aucun dossier ouvert" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DockPanel>
    <!-- Workbench -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="ActivityColumn" Width="48"/><ColumnDefinition x:Name="SidebarColumn" Width="250"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="AssistantSplitterColumn" Width="0"/><ColumnDefinition x:Name="SecondarySidebarColumn" Width="0"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="230"/></Grid.RowDefinitions>
      <!-- Activity bar -->
      <Border Grid.Column="0" Grid.RowSpan="3" Background="{DynamicResource ActivityBarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel><StackPanel DockPanel.Dock="Top">
          <Button x:Name="ActivityExplorer" Content="◫" FontSize="23" Height="48" Click="ShowExplorer_Click" ToolTip="Explorateur — Ctrl+Shift+E" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0"/>
          <Button x:Name="ActivitySearch" Content="⌕" FontSize="24" Height="48" Click="ShowSearch_Click" ToolTip="Recherche — Ctrl+Shift+F"/>
          <Button x:Name="ActivitySourceControl" Content="⑂" FontSize="23" Height="48" Click="ShowSourceControl_Click" ToolTip="Contrôle de code source"/>
          <Button x:Name="ActivityRun" Content="▷" FontSize="23" Height="48" Click="ShowRun_Click" ToolTip="Exécuter et déboguer"/>
          <Button x:Name="ActivityExtensions" Content="▧" FontSize="21" Height="48" Click="ShowExtensions_Click" ToolTip="Extensions"/>
        </StackPanel><StackPanel DockPanel.Dock="Bottom"><Button Content="⚙" FontSize="22" Height="48" Click="Settings_Click" ToolTip="Gérer les paramètres"/><Button Content="✦" Foreground="#FFFFA34A" FontSize="21" Height="48" Click="ToggleAssistant_Click" ToolTip="KeyceIA"/></StackPanel></DockPanel>
      </Border>
      <!-- Primary view container -->
      <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource SidebarBackground}">
        <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="14,0,8,0"><TextBlock x:Name="SidebarHeading" Text="EXPLORATEUR" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="…" Padding="4,2" Click="ExplorerMore_Click" ToolTip="Autres actions de l’Explorateur"/></StackPanel></DockPanel>
        <Grid Grid.Row="1">
          <Grid x:Name="ExplorerView"><DockPanel>
            <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="WorkspaceFolderLabel" Text="OUVRIR UN DOSSIER POUR COMMENCER" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="15,8,8,8"/><DockPanel Margin="8,0,8,7"><Button Content="📁" Click="OpenFolder_Click" ToolTip="Ouvrir un dossier"/><Button Content="＋ Fichier" Click="ExplorerNewFile_Click" HorizontalAlignment="Stretch"/><Button Content="＋ Dossier" Click="ExplorerNewFolder_Click" HorizontalAlignment="Stretch"/><Button Content="⟳" Click="ExplorerRefresh_Click" ToolTip="Actualiser l’Explorateur"/></DockPanel></StackPanel>
            <TreeView x:Name="ExplorerTree" SelectedItemChanged="ExplorerTree_SelectedItemChanged" MouseDoubleClick="ExplorerTree_DoubleClick"/>
          </DockPanel></Grid>
          <Grid x:Name="SearchView" Visibility="Collapsed" Margin="12"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="RECHERCHE" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox x:Name="SearchQuery" Height="28" Margin="0,0,0,6" KeyDown="SearchQuery_KeyDown" ToolTip="Texte ou expression régulière à rechercher"/><WrapPanel><CheckBox x:Name="SearchMatchCase" Content="Aa" Margin="2,3" ToolTip="Respecter la casse"/><CheckBox x:Name="SearchWholeWord" Content="ab" Margin="4,3" ToolTip="Mot entier"/><CheckBox x:Name="SearchUseRegex" Content=".*" Margin="4,3" ToolTip="Utiliser une expression régulière"/></WrapPanel><TextBox x:Name="SearchFilesPattern" Height="25" Margin="0,3" ToolTip="Inclure les fichiers, glob séparés par virgule (ex. **/*.cs)"/><TextBox x:Name="SearchExcludePattern" Height="25" Margin="0,3" ToolTip="Exclure les fichiers, glob séparés par virgule"/><Button Content="⌕ Rechercher dans les fichiers" Click="SearchWorkspace_Click" HorizontalAlignment="Stretch" Margin="0,6,0,4"/><TextBlock Text="Remplacer" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBox x:Name="SearchReplacement" Height="28" ToolTip="Texte de remplacement; en mode regex, $1, $2 et $&amp; sont pris en charge"/><Button Content="Prévisualiser les remplacements…" Click="PreviewReplace_Click" HorizontalAlignment="Stretch" Margin="0,5,0,6"/><TextBlock x:Name="SearchStatus" Text="La recherche ignore les dossiers .git, bin, obj, node_modules et .idea." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="1,2,1,7"/></StackPanel><ListBox x:Name="SearchResults" MouseDoubleClick="SearchResults_DoubleClick" Background="Transparent" BorderThickness="0"/></DockPanel></Grid>
          <Grid x:Name="SourceControlView" Visibility="Collapsed" Margin="12"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="CONTRÔLE DE CODE SOURCE" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox x:Name="CommitMessage" Height="48" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Message de validation"/><Button Content="✓ Valider" Click="Commit_Click" HorizontalAlignment="Stretch" Background="{DynamicResource AccentBrush}" Margin="0,7,0,5"/><WrapPanel Margin="-3,0,0,5"><Button Content="⑂ Branche" Click="GitBranch_Click" ToolTip="Changer de branche"/><Button Content="↓ Pull" Click="GitPull_Click" ToolTip="Récupérer la branche distante"/><Button Content="↑ Push" Click="GitPush_Click" ToolTip="Envoyer la branche suivie"/><Button Content="⟳" Click="RefreshGit_Click" ToolTip="Actualiser l’état Git"/><Button Content="Associer GitHub" Click="AssociateGitHub_Click" ToolTip="Associer le remote origin à un dépôt GitHub"/><Button Content="✓ Valider le lien" Click="ValidateGitHubLink_Click" ToolTip="Vérifier que le remote GitHub est accessible"/><Button Content="Ouvrir GitHub" Click="OpenGitHub_Click" ToolTip="Ouvrir le dépôt distant dans le navigateur"/></WrapPanel><TextBlock x:Name="GitBranchLabel" Text="Aucun dépôt Git détecté" Foreground="{DynamicResource MutedBrush}"/></StackPanel><ListBox x:Name="GitChanges" MouseDoubleClick="GitChanges_DoubleClick" Background="Transparent" BorderThickness="0"/></DockPanel></Grid>
          <Grid x:Name="RunView" Visibility="Collapsed" Margin="12"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="EXÉCUTER ET DÉBOGUER" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,12"/><Button Content="▷ Exécuter le fichier" Click="Run_Click" HorizontalContentAlignment="Left"/><TextBlock Text="Configuration launch.json" FontWeight="SemiBold" Margin="4,14,4,4"/><DockPanel><ComboBox x:Name="DebugConfigurations" MinWidth="150" SelectionChanged="DebugConfigurations_SelectionChanged"/><Button Content="⟳" Click="RefreshDebugConfigurations_Click" ToolTip="Recharger .vscode/launch.json"/></DockPanel><WrapPanel><Button Content="Créer la configuration Python" Click="CreateDebugConfig_Click" ToolTip="Créer .vscode/launch.json pour le fichier actif"/><Button Content="Ouvrir launch.json" Click="OpenDebugConfig_Click" ToolTip="Ouvrir le fichier de configuration dans l’éditeur"/></WrapPanel><TextBlock x:Name="DebugStatusText" Text="Ouvrez un dossier contenant .vscode/launch.json pour charger les configurations." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4,6,4,6"/><TextBlock Text="Points d’arrêt pour le script cible · numéros de ligne séparés par des virgules" TextWrapping="Wrap" Margin="4,8,4,3"/><TextBox x:Name="DebugBreakpointLines" Height="28" ToolTip="Exemple : 8, 12, 20"/><Button Content="▶ Démarrer le débogage Python" Click="DebugStart_Click" HorizontalContentAlignment="Left" Background="{DynamicResource AccentBrush}" Margin="0,8,0,4"/><WrapPanel><Button Content="▶ Continuer" Click="DebugContinue_Click" ToolTip="Continuer (F5)"/><Button Content="⏸ Pause" Click="DebugPause_Click"/><Button Content="↷ Pas à pas principal" Click="DebugNext_Click"/><Button Content="↓ Entrer" Click="DebugStepIn_Click"/><Button Content="↑ Sortir" Click="DebugStepOut_Click"/><Button Content="↻ Redémarrer" Click="DebugRestart_Click"/><Button Content="⏹ Arrêter" Click="DebugStop_Click"/></WrapPanel><TextBlock Text="L’intégration DAP utilise l’adaptateur Python Debugger (debugpy, MIT) s’il est installé. Les configurations C#/C++ sont détectées mais leurs adaptateurs VS Code ne sont pas lancés. Les points d’arrêt se définissent ici par numéro de ligne; les vues Variables/Appels restent à intégrer." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="8,12,8,0"/></StackPanel></ScrollViewer></Grid>
          <Grid x:Name="ExtensionsView" Visibility="Collapsed" Margin="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0"><TextBlock Text="EXTENSIONS · OPEN VSX" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/><DockPanel><TextBox x:Name="ExtensionSearch" Height="28" KeyDown="ExtensionSearch_KeyDown"/><Button Content="⌕" Click="SearchMarketplace_Click" ToolTip="Rechercher des extensions"/></DockPanel><TextBlock x:Name="ExtensionGalleryStatus" Text="Recherche dans le catalogue public Open VSX." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="2,7,2,2"/><DockPanel Margin="2,0,2,5"><Button x:Name="CancelExtensionOperationButton" Content="Annuler" Visibility="Collapsed" Click="CancelExtensionOperation_Click" DockPanel.Dock="Right"/><ProgressBar x:Name="ExtensionDownloadProgress" Height="8" Minimum="0" Maximum="100" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,0"/></DockPanel></StackPanel>
            <ListBox x:Name="ExtensionResults" Grid.Row="1" SelectionChanged="ExtensionResults_SelectionChanged" Background="Transparent" BorderThickness="0"/>
            <StackPanel Grid.Row="2"><TextBlock x:Name="ExtensionDetails" Text="Sélectionnez une extension pour voir sa description." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" MaxHeight="90" Margin="0,8,0,5"/><Button x:Name="InstallGalleryExtensionButton" Content="Télécharger et installer depuis Open VSX" IsEnabled="False" Click="InstallGalleryExtension_Click" Background="{DynamicResource AccentBrush}"/><Button x:Name="DownloadExtensionButton" Content="Télécharger seulement le VSIX" IsEnabled="False" Click="DownloadExtension_Click" Margin="0,5,0,0"/><Button x:Name="InstallExtensionButton" Content="Installer un VSIX local" Click="InstallVsix_Click" Margin="0,5,0,0"/><Button Content="Importer les extensions VS Code" Click="ImportVsCodeExtensions_Click" Margin="0,5,0,0"/><Button x:Name="ActivateExtensionButton" Content="Activer une extension installée…" Click="ActivateInstalledExtension_Click" Margin="0,5,0,0" Background="{DynamicResource AccentBrush}"/></StackPanel>
            <StackPanel Grid.Row="3" Margin="0,9,0,0"><TextBlock Text="EXTENSIONS INSTALLÉES" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="InstalledExtensionsStatus" Text="Aucune extension installée" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,3"/><ListBox x:Name="InstalledExtensions" MaxHeight="64" Background="Transparent" BorderThickness="0"/><TextBlock Text="COMMANDES DES EXTENSIONS ACTIVES" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock x:Name="ExtensionHostStatus" Text="Hôte non démarré · activation manuelle requise" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/><ListBox x:Name="ExtensionCommands" MaxHeight="90" MouseDoubleClick="RunExtensionCommand_Click" Background="Transparent" BorderThickness="0"/></StackPanel>
          </Grid>
        </Grid>
      </Grid>
      <GridSplitter x:Name="WorkbenchGridSplitter" Grid.Column="2" Grid.Row="0" Grid.RowSpan="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Grid x:Name="EditorPanelHost" Grid.Column="3" Grid.Row="0" Grid.RowSpan="3">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="PanelLeftColumn" Width="0"/><ColumnDefinition x:Name="PanelVerticalSplitterColumn" Width="0"/><ColumnDefinition x:Name="EditorRightColumn" Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition x:Name="EditorTopRow" Height="*"/><RowDefinition x:Name="PanelHorizontalSplitterRow" Height="5"/><RowDefinition x:Name="PanelRow" Height="230"/></Grid.RowDefinitions>
      </Grid>
      <!-- Editor region -->
      <Grid x:Name="EditorRegion" Grid.Column="3" Grid.Row="0">
        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <DockPanel><StackPanel x:Name="EditorTabs" Orientation="Horizontal"/><Button Content="+" DockPanel.Dock="Right" Click="NewFile_Click" ToolTip="Nouvel éditeur"/><Button Content="▦" DockPanel.Dock="Right" Click="SplitEditor_Click" ToolTip="Partager verticalement / ouvrir côte à côte"/><Button Content="▤" DockPanel.Dock="Right" Click="SplitEditorHorizontal_Click" ToolTip="Partager horizontalement"/><Button Content="×" DockPanel.Dock="Right" Click="CloseEditorGroup_Click" ToolTip="Fermer le groupe secondaire"/></DockPanel>
        </Border>
        <DockPanel Grid.Row="1" Background="{DynamicResource EditorBackground}"><TextBlock x:Name="Breadcrumbs" Text="Aucun fichier ouvert" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="14,0"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="▶" Width="30" Height="24" Margin="2,0" Background="#FF16845B" Foreground="White" FontWeight="Bold" Click="Run_Click" ToolTip="Exécuter le fichier ou projet ouvert · Ctrl+F5"/><Button Content="⟲" Click="FormatDocument_Click" ToolTip="Formater le document"/></StackPanel></DockPanel>
        <Grid Grid.Row="2" Background="{DynamicResource EditorBackground}"><wv:WebView2 x:Name="CodeEditor" DefaultBackgroundColor="#FF1E1E1E"/></Grid>
      </Grid>
      <GridSplitter x:Name="AssistantGridSplitter" Grid.Column="4" Grid.Row="0" Grid.RowSpan="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Visibility="Collapsed"/>
      <!-- Secondary sidebar / KeyceIA -->
      <Border Grid.Column="5" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" x:Name="SecondarySidebar">
        <DockPanel Margin="10"><StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock Text="KEYCEIA" FontWeight="SemiBold" Foreground="#FFFFA34A" Margin="4,8,0,12"/><Button Content="×" DockPanel.Dock="Right" Click="ToggleAssistant_Click"/></DockPanel><TextBlock Text="Assistant Gemini · le contexte n’est envoyé qu’à votre demande." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="4,0,4,10"/></StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <ListBox x:Name="AssistantContextList" Height="56" Visibility="Collapsed" DisplayMemberPath="DisplayName" Background="{DynamicResource EditorBackground}" BorderBrush="{DynamicResource BorderBrush}" ToolTip="Fichiers et dossiers joints au prochain message KeyceIA"/>
            <WrapPanel Margin="-3,2,0,3"><Button Content="＋ Fichier" Click="AttachAssistantFile_Click" ToolTip="Joindre un fichier au message envoyé à Gemini"/><Button Content="＋ Dossier" Click="AttachAssistantFolder_Click" ToolTip="Joindre les fichiers texte et code d’un dossier"/><Button Content="Fichier ouvert" Click="AttachActiveDocument_Click" ToolTip="Joindre le fichier actif, y compris ses modifications non enregistrées"/><Button Content="Retirer" Click="RemoveAssistantContext_Click" ToolTip="Retirer le contexte sélectionné"/><Button Content="Coller le code" Click="PasteCodeIntoPrompt_Click" ToolTip="Coller le contenu du presse-papiers dans le message"/></WrapPanel>
            <TextBlock x:Name="AssistantContextStatus" Text="Aucun fichier joint · colle aussi du code avec Ctrl+V" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,0,2,4"/>
            <TextBox x:Name="PromptBox" Height="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" KeyDown="PromptBox_KeyDown" ToolTip="Écris une question ou colle du code ici. Ctrl+Entrée pour envoyer."/>
            <Button Content="Envoyer" Click="Ask_Click" Background="{DynamicResource AccentBrush}" HorizontalContentAlignment="Center" Margin="0,8,0,0"/><Button Content="Modifier le fichier avec KeyceIA" Click="EditFileWithAi_Click" HorizontalContentAlignment="Center" Margin="0,4,0,0"/><Button Content="Proposer du code au curseur" Click="Complete_Click" HorizontalContentAlignment="Center" Margin="0,4,0,0"/><WrapPanel><Button Content="Appliquer au fichier" Click="ApplyAiEdit_Click"/><Button Content="Rejeter" Click="RejectAiEdit_Click"/></WrapPanel>
          </StackPanel>
          <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><RichTextBox x:Name="AssistantOutput" Grid.Row="0" IsReadOnly="True" IsDocumentEnabled="False" Background="Transparent" Foreground="{DynamicResource EditorForeground}" BorderThickness="0" Padding="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/><TextBox x:Name="AiProposalPreview" Grid.Row="1" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Code, Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinHeight="120" Margin="4"/></Grid>
        </DockPanel>
      </Border>
      <!-- Bottom panel -->
      <GridSplitter x:Name="PanelSplitter" Grid.Column="3" Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Grid x:Name="PanelRegion" Grid.Column="3" Grid.Row="2" Background="{DynamicResource PanelBackground}">
        <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><DockPanel><StackPanel Orientation="Horizontal"><Button Content="PROBLÈMES" Click="ShowProblems_Click"/><Button Content="SORTIE" Click="ShowOutput_Click"/><Button Content="CONSOLE DE DÉBOGAGE" Click="ShowDebugConsole_Click"/><Button Content="TERMINAL" Click="ShowTerminal_Click" Background="{DynamicResource PanelBackground}"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="+" Click="NewTerminal_Click" ToolTip="Nouveau terminal"/><Button Content="⌄" Click="SelectTerminalProfile_Click" ToolTip="Nouveau terminal avec ce profil"/><Button Content="⟳" Click="RestartTerminal_Click" ToolTip="Redémarrer le terminal actif"/><Button Content="×" Click="KillTerminal_Click" ToolTip="Terminer le terminal actif"/><Button Content="×" Click="TogglePanel_Click" ToolTip="Masquer le panneau"/></StackPanel></DockPanel></Border>
        <Grid Grid.Row="1">
          <Grid x:Name="TerminalPanel">
            <Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Background="{DynamicResource PanelBackground}"><TextBlock x:Name="TerminalProfileLabel" Text="PowerShell 7" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0"/><Button x:Name="ExplainTerminalErrorButton" Content="✦ Expliquer l’erreur" DockPanel.Dock="Right" IsEnabled="False" Click="ExplainTerminalError_Click" ToolTip="Analyser l’erreur · envoie les 24 000 derniers caractères du terminal à KeyceIA lorsque tu cliques"/><ListBox x:Name="TerminalTabs" DockPanel.Dock="Left" Height="28" MinWidth="80" BorderThickness="0" Background="Transparent" SelectionChanged="TerminalTabs_SelectionChanged" MouseDoubleClick="TerminalTabs_MouseDoubleClick"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,4"/><Setter Property="Margin" Value="1,0"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="BorderBrush" Value="Transparent"/></Style></ListBox.ItemContainerStyle></ListBox></DockPanel>
            <Border x:Name="TerminalAiExplanationPanel" Grid.Row="1" Visibility="Collapsed" Padding="8" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1"><DockPanel><Button Content="×" DockPanel.Dock="Right" VerticalAlignment="Top" Click="CloseTerminalAiExplanation_Click" ToolTip="Fermer l’explication"/><ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="TerminalAiExplanation" TextWrapping="Wrap" Foreground="{DynamicResource EditorForeground}"/></ScrollViewer></DockPanel></Border>
            <wv:WebView2 x:Name="TerminalWebView" Grid.Row="2" DefaultBackgroundColor="#FF181818"/>
          </Grid>
          <ListView x:Name="ProblemsPanel" Visibility="Collapsed" Background="{DynamicResource PanelBackground}" BorderThickness="0" MouseDoubleClick="ProblemsPanel_DoubleClick"><ListView.View><GridView><GridViewColumn Header="Sévérité" DisplayMemberBinding="{Binding Severity}" Width="100"/><GridViewColumn Header="Code" DisplayMemberBinding="{Binding Code}" Width="90"/><GridViewColumn Header="Message" DisplayMemberBinding="{Binding Message}" Width="600"/><GridViewColumn Header="Fichier" DisplayMemberBinding="{Binding File}" Width="250"/><GridViewColumn Header="Ligne" DisplayMemberBinding="{Binding Line}" Width="65"/><GridViewColumn Header="Colonne" DisplayMemberBinding="{Binding Column}" Width="70"/></GridView></ListView.View></ListView>
          <TextBox x:Name="OutputPanel" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource ForegroundBrush}" BorderThickness="0" Padding="12"/>
          <TextBox x:Name="DebugConsolePanel" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource ForegroundBrush}" BorderThickness="0" Padding="12"/>
        </Grid>
      </Grid>
    </Grid>
    <!-- Status bar -->
    <DockPanel Grid.Row="3" Background="{DynamicResource StatusBarBackground}" LastChildFill="True"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button x:Name="StatusGitBranch" Content="⑂ main" Padding="8,2" Click="ShowSourceControl_Click"/><Button x:Name="StatusErrors" Content="× 0" Padding="6,2" Click="ShowProblems_Click"/><Button x:Name="StatusWarnings" Content="⚠ 0" Padding="6,2" Click="ShowProblems_Click"/><TextBlock x:Name="StatusMessage" Text="Prêt" VerticalAlignment="Center" Margin="10,0"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="StatusCursor" Content="Ln 1, Col 1" Padding="8,2"/><Button x:Name="StatusIndentation" Content="Espaces: 4" Padding="8,2" Click="Settings_Click" ToolTip="Ouvrir les paramètres de l’éditeur"/><Button x:Name="StatusEncoding" Content="UTF-8" Padding="8,2" Click="Encoding_Click" ToolTip="Changer l’encodage du fichier"/><Button x:Name="StatusEol" Content="CRLF" Padding="8,2" Click="Eol_Click" ToolTip="Changer la fin de ligne"/><Button x:Name="StatusLanguage" Content="Texte brut" Padding="8,2" Click="Language_Click"/><Button x:Name="GeminiCompletionPauseButton" Content="🤖" Padding="8,2" Click="GeminiCompletionPauseButton_Click" ToolTip="Gérer la pause de l’autocomplétion Gemini"/><Button Content="◖" Padding="8,2" IsEnabled="False" ToolTip="Notifications non configurées"/></StackPanel></DockPanel>
  </Grid>
</Window>


