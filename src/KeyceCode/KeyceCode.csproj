<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KeyceCode</AssemblyName>
    <RootNamespace>KeyceCode</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\KeyceCode.png" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <Content Include="WebEditor\dist\**\*" Condition="Exists('WebEditor\dist')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
